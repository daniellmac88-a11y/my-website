{% comment %}
  Shared font, design tokens, product-card styles and quick-add script
  for the Petphobia sections. Safe to render more than once per page.
{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap">

<style>
  .pp {
    --pp-ink: #111111;
    --pp-muted: #6f6f6f;
    --pp-line: #e7e7e7;
    --pp-box: #f5f5f5;
    --pp-sale: #e4572e;
    font-family: 'Outfit', system-ui, -apple-system, sans-serif;
    color: var(--pp-ink);
    background: #fff;
  }
  .pp *, .pp *::before, .pp *::after { box-sizing: border-box; }
  .pp h1, .pp h2, .pp h3 { font-family: inherit; color: inherit; }
  .pp__wrap { max-width: 1440px; margin: 0 auto; padding: 0 16px; }
  @media (min-width: 750px) { .pp__wrap { padding: 0 40px; } }

  /* ---------- Product card ---------- */
  .pp-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 12px; }
  @media (min-width: 750px) { .pp-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px 24px; } }
  @media (min-width: 1100px) { .pp-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 48px 36px; } }

  .pp-card { position: relative; text-align: center; }
  .pp-card__media {
    position: relative; display: block; aspect-ratio: 1 / 0.96; border-radius: 12px;
    background: var(--pp-box); overflow: hidden;
  }
  .pp-card__media img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain;
    padding: 8%; transition: opacity .35s ease, transform .5s ease;
  }
  .pp-card__media .pp-card__alt { opacity: 0; }
  .pp-card:hover .pp-card__media .pp-card__alt { opacity: 1; }
  .pp-card:hover .pp-card__media img { transform: scale(1.04); }
  .pp-card__badge {
    position: absolute; top: 12px; left: 12px; z-index: 2; padding: 4px 12px; border-radius: 99px;
    background: var(--pp-sale); color: #fff; font-size: 12px; font-weight: 600;
  }
  .pp-card__badge--sold { background: var(--pp-ink); }
  .pp-card__actions {
    position: absolute; left: 0; right: 0; bottom: 16px; z-index: 3;
    display: flex; justify-content: center; gap: 12px;
    opacity: 0; transform: translateY(10px); transition: opacity .25s ease, transform .25s ease;
  }
  .pp-card:hover .pp-card__actions, .pp-card:focus-within .pp-card__actions { opacity: 1; transform: none; }
  @media (hover: none) { .pp-card__actions { opacity: 1; transform: none; bottom: 10px; } }
  .pp-card__icon {
    width: 48px; height: 48px; border-radius: 50%; border: 0; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    background: rgba(90, 90, 90, .78); color: #fff; text-decoration: none;
    transition: background .2s ease, transform .2s ease;
  }
  .pp-card__icon:hover { background: var(--pp-ink); transform: translateY(-2px); }
  .pp-card__icon.is-done { background: #1f8a4c; }
  .pp-card__icon[disabled] { opacity: .5; cursor: not-allowed; }
  @media (max-width: 749px) { .pp-card__icon { width: 38px; height: 38px; } .pp-card__icon svg { width: 16px; height: 16px; } }
  .pp-card__title {
    display: block; margin: 18px 0 8px; font-size: 18px; font-weight: 600; line-height: 1.3;
    color: var(--pp-ink); text-decoration: none;
  }
  .pp-card__title:hover { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 749px) { .pp-card__title { font-size: 15px; margin-top: 12px; } }
  .pp-card__price { font-size: 18px; font-weight: 400; }
  .pp-card__price s { color: var(--pp-muted); margin-left: 6px; font-size: 15px; }
  .pp-card__price--sale span { color: var(--pp-sale); }
</style>

<script>
  if (!window.ppQuickAddInit) {
    window.ppQuickAddInit = true;
    window.ppRefreshCartCount = function () {
      return fetch(window.Shopify && Shopify.routes ? Shopify.routes.root + 'cart.js' : '/cart.js')
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          document.querySelectorAll('.cart-count-bubble span[aria-hidden="true"], [data-cart-count]').forEach(function (el) {
            el.textContent = cart.item_count;
          });
          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail: cart }));
        })
        .catch(function () {});
    };
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-pp-quick-add]');
      if (!btn) return;
      e.preventDefault();
      if (btn.disabled) return;
      btn.disabled = true;
      var root = window.Shopify && Shopify.routes ? Shopify.routes.root : '/';
      fetch(root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: [{ id: Number(btn.dataset.ppQuickAdd), quantity: 1 }] })
      })
        .then(function (r) { if (!r.ok) throw new Error(); btn.classList.add('is-done'); return window.ppRefreshCartCount(); })
        .catch(function () { window.location.href = btn.dataset.url; })
        .finally(function () { setTimeout(function () { btn.classList.remove('is-done'); btn.disabled = false; }, 1600); });
    });
  }
</script>

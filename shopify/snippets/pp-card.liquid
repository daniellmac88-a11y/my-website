{% comment %}
  Product card. Usage: {% render 'pp-card', card_product: product %}
{% endcomment %}
{%- liquid
  assign p = card_product
  assign v = p.selected_or_first_available_variant
  assign img = p.featured_media
  assign img_alt = p.title | escape
  assign second = nil
  if p.media.size > 1
    assign second = p.media[1]
  endif
-%}
<div class="pp-card">
  <a class="pp-card__media" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
    {%- if p.available == false -%}
      <span class="pp-card__badge pp-card__badge--sold">Sold out</span>
    {%- elsif p.compare_at_price > p.price -%}
      <span class="pp-card__badge">Sale</span>
    {%- endif -%}
    {%- if img -%}
      {{ img | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 400, 600, 800', sizes: '(min-width: 1100px) 25vw, (min-width: 750px) 33vw, 50vw', alt: img_alt }}
      {%- if second and second.media_type == 'image' -%}
        {{ second | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 400, 600, 800', sizes: '(min-width: 1100px) 25vw, (min-width: 750px) 33vw, 50vw', alt: '', class: 'pp-card__alt' }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
  </a>

  <div class="pp-card__actions">
    <a class="pp-card__icon" href="{{ p.url }}" aria-label="View {{ img_alt }}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg>
    </a>
    {%- if p.has_only_default_variant and v.available -%}
      <button type="button" class="pp-card__icon" data-pp-quick-add="{{ v.id }}" data-url="{{ p.url }}" aria-label="Add {{ img_alt }} to cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg>
      </button>
    {%- else -%}
      <a class="pp-card__icon" href="{{ p.url }}" aria-label="Choose options for {{ img_alt }}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg>
      </a>
    {%- endif -%}
  </div>

  <a class="pp-card__title" href="{{ p.url }}">{{ p.title }}</a>
  <div class="pp-card__price{% if p.compare_at_price > p.price %} pp-card__price--sale{% endif %}">
    <span>{% if p.price_varies %}From {% endif %}{{ p.price | money }}</span>
    {%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s>{%- endif -%}
  </div>
</div>

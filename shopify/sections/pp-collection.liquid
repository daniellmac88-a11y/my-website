{% render 'pp-base' %}
<section class="pp pp-coll">
  <div class="pp__wrap">
    <header class="pp-coll__head">
      <nav class="pp-coll__crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a> <span aria-hidden="true">/</span> <span>{{ collection.title | default: 'Products' }}</span>
      </nav>
      <h1 class="pp-coll__title">{{ collection.title | default: 'Products' }}</h1>
      {%- if collection.description != blank -%}<div class="pp-coll__desc">{{ collection.description }}</div>{%- endif -%}
    </header>

    {%- paginate collection.products by section.settings.per_page -%}
      <div class="pp-coll__bar">
        <span class="pp-coll__count">{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}</span>
        <label class="pp-coll__sort">
          <span>Sort by</span>
          <select onchange="var u=new URL(location.href);u.searchParams.set('sort_by',this.value);u.searchParams.delete('page');location.href=u.toString();">
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
            {%- endfor -%}
          </select>
        </label>
      </div>

      <div class="pp-grid">
        {%- for product in collection.products -%}
          {% render 'pp-card', card_product: product %}
        {%- else -%}
          <p class="pp-coll__empty">No products found in this collection.</p>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pp-coll__pages" aria-label="Pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Previous page">&larr;</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span class="is-current" aria-current="page">{{ part.title }}</span>
            {%- else -%}
              <span>{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Next page">&rarr;</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

<style>
  .pp-coll { padding: 32px 0 80px; }
  .pp-coll__head { text-align: center; margin-bottom: 32px; }
  .pp-coll__crumbs { font-size: 14px; color: var(--pp-muted); margin-bottom: 10px; }
  .pp-coll__crumbs a { color: inherit; text-decoration: none; }
  .pp-coll__title { margin: 0; font-size: clamp(32px, 4.4vw, 56px); font-weight: 700; letter-spacing: -.01em; }
  .pp-coll__desc { max-width: 640px; margin: 12px auto 0; color: var(--pp-muted); line-height: 1.6; }
  .pp-coll__bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 0; margin-bottom: 32px; border-top: 1px solid var(--pp-line); border-bottom: 1px solid var(--pp-line); }
  .pp-coll__count { color: var(--pp-muted); font-size: 15px; }
  .pp-coll__sort { display: flex; align-items: center; gap: 10px; font-size: 15px; }
  .pp-coll__sort select { font: inherit; padding: 10px 36px 10px 16px; border: 1.5px solid var(--pp-ink); border-radius: 99px; background: #fff; cursor: pointer; }
  .pp-coll__pages { display: flex; justify-content: center; gap: 8px; margin-top: 56px; }
  .pp-coll__pages a, .pp-coll__pages span { min-width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; border-radius: 99px; text-decoration: none; color: var(--pp-ink); border: 1.5px solid var(--pp-line); }
  .pp-coll__pages .is-current { background: var(--pp-ink); color: #fff; border-color: var(--pp-ink); }
  .pp-coll__pages a:hover { border-color: var(--pp-ink); }
  .pp-coll__empty { grid-column: 1 / -1; text-align: center; color: var(--pp-muted); }
</style>

{% schema %}
{
  "name": "Collection (PetJoy)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 }
  ]
}
{% endschema %}

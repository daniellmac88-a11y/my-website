    display: flex;
    align-items: center;
  }

  .nordic-review-count {
    font-size: 13px;
    color: #6E737D;
    font-weight: 400;
  }

  .nordic-summary {
    font-size: 15px;
    line-height: 1.6;
    color: #555A64;
    margin-bottom: 18px;

  }

  .nordic-product-title {
    font-family: 'Poppins', sans-serif;
    font-size: 34px;
    font-weight: 600;
    line-height: 1.2;
    color: #1F242D;
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }


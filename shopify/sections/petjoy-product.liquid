{% comment %}
  PetJoy — Product page
  Large image box + thumbnails, vendor / title / price, option pills, quantity,
  add to cart, accordions, related products, and a sticky bottom add-to-cart bar
  with quantity and option dropdowns.
{% endcomment %}
{% render 'pp-base' %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign sid = section.id
  assign form_id = 'PPForm-' | append: sid
-%}

<section class="pp pp-pdp" id="PP-{{ sid }}">
  <div class="pp__wrap">
    <div class="pp-pdp__grid">

      {%- comment -%} GALLERY {%- endcomment -%}
      <div class="pp-pdp__gallery">
        <div class="pp-pdp__stage">
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="pp-card__badge" data-pp-sale>Sale</span>
          {%- endif -%}
          <div class="pp-pdp__slides" data-pp-slides>
            {%- for media in product.media -%}
              {%- assign media_alt = media.alt | default: product.title | escape -%}
              {%- if forloop.first -%}{%- assign img_loading = 'eager' -%}{%- else -%}{%- assign img_loading = 'lazy' -%}{%- endif -%}
              <div class="pp-pdp__slide" data-media-id="{{ media.id }}">
                {%- if media.media_type == 'image' -%}
                  {{ media | image_url: width: 1600 | image_tag: loading: img_loading, widths: '500, 800, 1000, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw', alt: media_alt }}
                {%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}
                  {{ media | media_tag: image_size: '1200x', autoplay: false, loop: true, controls: true }}
                {%- else -%}
                  {{ media.preview_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: media_alt }}
                {%- endif -%}
              </div>
            {%- else -%}
              <div class="pp-pdp__slide">{{ 'product-1' | placeholder_svg_tag }}</div>
            {%- endfor -%}
          </div>
          {%- if product.media.size > 1 -%}
            <button type="button" class="pp-pdp__arrow pp-pdp__arrow--prev" data-pp-prev aria-label="Previous image"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg></button>
            <button type="button" class="pp-pdp__arrow pp-pdp__arrow--next" data-pp-next aria-label="Next image"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg></button>
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="pp-pdp__thumbs">
            {%- for media in product.media -%}
              <button type="button" class="pp-pdp__thumb{% if forloop.first %} is-active{% endif %}" data-pp-thumb="{{ forloop.index0 }}" aria-label="Show image {{ forloop.index }}">
                {{ media.preview_image | image_url: width: 200, height: 200, crop: 'center' | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} INFO {%- endcomment -%}
      <div class="pp-pdp__info">
        {%- liquid
          assign brand = product.vendor
          if brand == blank or brand == shop.name
            assign brand = section.settings.brand_name
          endif
        -%}
        {%- if section.settings.show_vendor and brand != blank -%}
          <p class="pp-pdp__vendor">{{ brand }}</p>
        {%- endif -%}
        <h1 class="pp-pdp__title">{{ product.title }}</h1>

        <div class="pp-pdp__price">
          <span data-pp-now>{{ current_variant.price | money_with_currency }}</span>
          <s data-pp-was {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
        </div>
        {%- if section.settings.price_note != blank -%}
          <p class="pp-pdp__note">{{ section.settings.price_note }}</p>
        {%- endif -%}

        <hr class="pp-pdp__hr">

        {%- form 'product', product, id: form_id, class: 'pp-pdp__form', novalidate: 'novalidate', data-pp-form: '' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-pp-variant>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <fieldset class="pp-pdp__opt" data-pp-option="{{ forloop.index0 }}">
                <legend>{{ option.name }}</legend>
                <div class="pp-pdp__pills">
                  {%- for value in option.values -%}
                    <button type="button" class="pp-pdp__pill{% if option.selected_value == value %} is-active{% endif %}" data-value="{{ value | escape }}" aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}">{{ value }}</button>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          {%- endunless -%}

          <p class="pp-pdp__label">Quantity</p>
          <div class="pp-pdp__buy">
            <div class="pp-qty">
              <button type="button" data-pp-step="-1" aria-label="Decrease quantity">&minus;</button>
              <input type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity" data-pp-qty>
              <button type="button" data-pp-step="1" aria-label="Increase quantity">+</button>
            </div>
            <button type="submit" name="add" class="pp-btn" data-pp-atc {% unless current_variant.available %}disabled{% endunless %}>
              {%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
            </button>
          </div>
          {%- if section.settings.show_dynamic_checkout -%}
            <div class="pp-pdp__dynamic">{{ form | payment_button }}</div>
          {%- endif -%}
          <p class="pp-pdp__msg" role="status" aria-live="polite" data-pp-msg hidden></p>
        {%- endform -%}

        <div class="pp-pdp__accs">
          <details class="pp-pdp__acc" open>
            <summary>Description</summary>
            <div class="pp-pdp__acc-body">{{ product.description | default: 'More details coming soon.' }}</div>
          </details>
          {%- if section.settings.shipping_text != blank -%}
            <details class="pp-pdp__acc">
              <summary>Shipping &amp; returns</summary>
              <div class="pp-pdp__acc-body">{{ section.settings.shipping_text }}</div>
            </details>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- comment -%} RELATED {%- endcomment -%}
    {%- if section.settings.show_related -%}
      <div class="pp-pdp__related" data-pp-related data-url="{{ routes.product_recommendations_url }}?section_id={{ sid }}&product_id={{ product.id }}&limit=4">
        {%- if recommendations.performed and recommendations.products_count > 0 -%}
          <h2 class="pp-pdp__related-title">{{ section.settings.related_heading }}</h2>
          <div class="pp-grid">
            {%- for rec in recommendations.products -%}
              {% render 'pp-card', card_product: rec %}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} STICKY BAR {%- endcomment -%}
  <div class="pp-bar" data-pp-bar aria-hidden="true">
    <div class="pp-bar__inner">
      <div class="pp-bar__thumb">
        {%- if product.featured_media -%}
          {{ product.featured_media | image_url: width: 180, height: 180, crop: 'center' | image_tag: loading: 'lazy', alt: '' }}
        {%- endif -%}
      </div>
      <div class="pp-bar__field pp-bar__field--qty">
        <span class="pp-bar__label">Quantity</span>
        <div class="pp-qty pp-qty--sm">
          <button type="button" data-pp-bar-step="-1" aria-label="Decrease quantity" tabindex="-1">&minus;</button>
          <input type="number" value="1" min="1" inputmode="numeric" aria-label="Quantity" data-pp-bar-qty tabindex="-1">
          <button type="button" data-pp-bar-step="1" aria-label="Increase quantity" tabindex="-1">+</button>
        </div>
      </div>
      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <label class="pp-bar__field">
            <span class="pp-bar__label">{{ option.name }}</span>
            <select class="pp-bar__select" data-pp-bar-option="{{ forloop.index0 }}" tabindex="-1">
              {%- for value in option.values -%}
                <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
              {%- endfor -%}
            </select>
          </label>
        {%- endfor -%}
      {%- endunless -%}
      <button type="button" class="pp-btn pp-btn--caps" data-pp-bar-atc tabindex="-1" {% unless current_variant.available %}disabled{% endunless %}>
        {%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
      </button>
      <button type="button" class="pp-bar__close" data-pp-bar-close aria-label="Close" tabindex="-1">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>

  <script type="application/json" data-pp-variants>{{ product.variants | json }}</script>
</section>

<script>
  (function () {
    var root = document.getElementById('PP-{{ sid }}');
    if (!root || root.dataset.ppInit) return;
    root.dataset.ppInit = '1';

    var variants = JSON.parse(root.querySelector('[data-pp-variants]').textContent);
    var moneyFormat = {{ shop.money_with_currency_format | json }};
    var form = root.querySelector('[data-pp-form]');
    var idInput = root.querySelector('[data-pp-variant]');
    var atc = root.querySelector('[data-pp-atc]');
    var barAtc = root.querySelector('[data-pp-bar-atc]');
    var msg = root.querySelector('[data-pp-msg]');
    var qty = root.querySelector('[data-pp-qty]');
    var barQty = root.querySelector('[data-pp-bar-qty]');

    function money(cents) {
      var v = (cents / 100).toFixed(2);
      var noDec = Math.round(cents / 100).toString();
      return moneyFormat.replace(/\{\{\s*(\w+)\s*\}\}/, function (_, k) {
        if (k === 'amount_no_decimals') return noDec;
        if (k === 'amount_with_comma_separator') return v.replace('.', ',');
        if (k === 'amount_no_decimals_with_comma_separator') return noDec;
        return Number(v).toLocaleString('en-US', { minimumFractionDigits: 2 });
      });
    }

    /* Gallery */
    var slides = root.querySelector('[data-pp-slides]');
    var thumbs = root.querySelectorAll('[data-pp-thumb]');
    var count = slides ? slides.children.length : 0;
    function cur() { return Math.round(slides.scrollLeft / Math.max(slides.clientWidth, 1)); }
    function goTo(i) { if (!count) return; i = (i + count) % count; slides.scrollTo({ left: slides.clientWidth * i, behavior: 'smooth' }); }
    var t;
    slides.addEventListener('scroll', function () {
      clearTimeout(t);
      t = setTimeout(function () { var i = cur(); thumbs.forEach(function (b, n) { b.classList.toggle('is-active', n === i); }); }, 60);
    }, { passive: true });
    thumbs.forEach(function (b) { b.addEventListener('click', function () { goTo(+b.dataset.ppThumb); }); });
    var prev = root.querySelector('[data-pp-prev]'), next = root.querySelector('[data-pp-next]');
    if (prev) prev.addEventListener('click', function () { goTo(cur() - 1); });
    if (next) next.addEventListener('click', function () { goTo(cur() + 1); });

    /* Variants — pills and bar dropdowns stay in sync */
    var groups = root.querySelectorAll('[data-pp-option]');
    var selects = root.querySelectorAll('[data-pp-bar-option]');
    function selected() {
      return Array.prototype.map.call(groups, function (g) { var a = g.querySelector('.is-active'); return a ? a.dataset.value : null; });
    }
    function findVariant(sel) {
      return variants.find(function (v) { return sel.every(function (val, k) { return v.options[k] === val; }); });
    }
    function setBtn(btn, v) {
      btn.disabled = !(v && v.available);
      btn.textContent = !v ? 'Unavailable' : v.available ? 'Add to cart' : 'Sold out';
    }
    function markUnavailable() {
      var sel = selected();
      groups.forEach(function (g, gi) {
        g.querySelectorAll('.pp-pdp__pill').forEach(function (p) {
          var test = sel.slice(); test[gi] = p.dataset.value;
          var m = findVariant(test);
          p.classList.toggle('is-unavailable', !m || !m.available);
        });
      });
    }
    function update() {
      var sel = selected();
      var v = findVariant(sel);
      setBtn(atc, v); setBtn(barAtc, v);
      selects.forEach(function (s, i) { s.value = sel[i]; });
      markUnavailable();
      if (!v) return;
      idInput.value = v.id;
      root.querySelector('[data-pp-now]').textContent = money(v.price);
      var was = root.querySelector('[data-pp-was]');
      var sale = root.querySelector('[data-pp-sale]');
      if (v.compare_at_price > v.price) { was.textContent = money(v.compare_at_price).replace(/\s*[A-Z]{3}$/, ''); was.hidden = false; if (sale) sale.hidden = false; }
      else { was.hidden = true; if (sale) sale.hidden = true; }
      if (v.featured_media) {
        var idx = Array.prototype.findIndex.call(slides.children, function (s) { return s.dataset.mediaId == v.featured_media.id; });
        if (idx > -1) goTo(idx);
      }
      var url = new URL(location.href); url.searchParams.set('variant', v.id); history.replaceState({}, '', url.toString());
    }
    function choose(gi, value) {
      var g = groups[gi];
      g.querySelectorAll('.pp-pdp__pill').forEach(function (p) {
        var on = p.dataset.value === value;
        p.classList.toggle('is-active', on); p.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      update();
    }
    groups.forEach(function (g, gi) {
      g.querySelectorAll('.pp-pdp__pill').forEach(function (p) { p.addEventListener('click', function () { choose(gi, p.dataset.value); }); });
    });
    selects.forEach(function (s, gi) { s.addEventListener('change', function () { choose(gi, s.value); }); });
    markUnavailable();

    /* Quantity — main and bar stay in sync */
    function setQty(n) { n = Math.max(1, parseInt(n, 10) || 1); qty.value = n; barQty.value = n; }
    root.querySelectorAll('[data-pp-step]').forEach(function (b) { b.addEventListener('click', function () { setQty(+qty.value + +b.dataset.ppStep); }); });
    root.querySelectorAll('[data-pp-bar-step]').forEach(function (b) { b.addEventListener('click', function () { setQty(+barQty.value + +b.dataset.ppBarStep); }); });
    qty.addEventListener('change', function () { setQty(qty.value); });
    barQty.addEventListener('change', function () { setQty(barQty.value); });

    /* Add to cart */
    function flash(text, isError) {
      msg.hidden = false; msg.classList.toggle('is-error', !!isError); msg.textContent = text + ' ';
      if (!isError) { var a = document.createElement('a'); a.href = {{ routes.cart_url | json }}; a.textContent = 'View cart →'; msg.appendChild(a); }
    }
    form.addEventListener('submit', function (e) {
      if (!window.fetch) return;
      e.preventDefault();
      atc.disabled = true; barAtc.disabled = true;
      fetch({{ routes.cart_add_url | json }} + '.js', { method: 'POST', headers: { 'Accept': 'application/json' }, body: new FormData(form) })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
        .then(function (res) {
          if (!res.ok) throw new Error(res.j.description || res.j.message || 'Could not add to cart');
          flash('Added to your cart!');
          barAtc.textContent = 'Added ✓';
          if (window.ppRefreshCartCount) window.ppRefreshCartCount();
        })
        .catch(function (err) { flash(err.message, true); })
        .finally(function () { setTimeout(update, 1400); atc.disabled = false; });
    });
    barAtc.addEventListener('click', function () {
      if (typeof form.requestSubmit === 'function') form.requestSubmit(); else atc.click();
    });

    /* Sticky bar: shows once the main Add to cart button scrolls out of view */
    var bar = root.querySelector('[data-pp-bar]');
    var dismissed = false;
    function showBar(on) {
      bar.classList.toggle('is-visible', on);
      bar.setAttribute('aria-hidden', on ? 'false' : 'true');
      bar.querySelectorAll('button, input, select').forEach(function (el) { el.tabIndex = on ? 0 : -1; });
    }
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        var e = entries[0];
        showBar(!dismissed && !e.isIntersecting && e.boundingClientRect.top < 0);
      }).observe(atc);
    }
    root.querySelector('[data-pp-bar-close]').addEventListener('click', function () { dismissed = true; showBar(false); });

    /* Related products */
    var rel = root.querySelector('[data-pp-related]');
    if (rel && !rel.children.length) {
      fetch(rel.dataset.url).then(function (r) { return r.text(); }).then(function (html) {
        var inner = new DOMParser().parseFromString(html, 'text/html').querySelector('[data-pp-related]');
        if (inner && inner.children.length) rel.innerHTML = inner.innerHTML;
      }).catch(function () {});
    }
  })();
</script>

<style>
  .pp-pdp { padding: 40px 0 120px; }
  .pp-pdp__grid { display: grid; gap: 32px; }
  @media (min-width: 990px) { .pp-pdp__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; align-items: start; } }

  .pp-pdp__stage { position: relative; background: var(--pp-box); }
  .pp-pdp__slides { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; aspect-ratio: 1 / 0.92; }
  .pp-pdp__slides::-webkit-scrollbar { display: none; }
  .pp-pdp__slide { flex: 0 0 100%; scroll-snap-align: start; display: flex; align-items: center; justify-content: center; }
  .pp-pdp__slide img, .pp-pdp__slide svg { width: 100%; height: 100%; object-fit: contain; padding: 6%; }
  .pp-pdp__slide video, .pp-pdp__slide iframe { width: 100%; height: 100%; }
  .pp-pdp__arrow { position: absolute; top: 50%; transform: translateY(-50%); width: 46px; height: 46px; border-radius: 50%; border: 0; background: #fff; color: var(--pp-ink); display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 0 4px 14px rgba(0,0,0,.08); }
  .pp-pdp__arrow--prev { left: 14px; } .pp-pdp__arrow--next { right: 14px; }
  .pp-pdp__thumbs { display: flex; gap: 12px; margin-top: 14px; overflow-x: auto; }
  .pp-pdp__thumb { flex: 0 0 88px; height: 88px; padding: 6px; border: 1.5px solid transparent; background: var(--pp-box); cursor: pointer; }
  .pp-pdp__thumb img { width: 100%; height: 100%; object-fit: contain; }
  .pp-pdp__thumb.is-active { border-color: var(--pp-ink); }

  @media (min-width: 990px) { .pp-pdp__info { position: sticky; top: 90px; } }
  .pp-pdp__vendor { margin: 0 0 8px; font-size: 20px; color: var(--pp-muted); }
  .pp-pdp__title { margin: 0 0 22px; font-size: clamp(30px, 3.4vw, 48px); font-weight: 700; line-height: 1.1; letter-spacing: -.01em; }
  .pp-pdp__price { display: flex; align-items: baseline; gap: 12px; font-size: clamp(26px, 2.6vw, 36px); font-weight: 500; letter-spacing: .02em; }
  .pp-pdp__price s { font-size: .55em; color: var(--pp-muted); font-weight: 400; }
  .pp-pdp__note { margin: 8px 0 0; font-size: 17px; color: var(--pp-muted); }
  .pp-pdp__hr { border: 0; border-top: 1px solid var(--pp-line); margin: 20px 0 28px; }

  .pp-pdp__opt { border: 0; margin: 0 0 26px; padding: 0; min-width: 0; }
  .pp-pdp__opt legend, .pp-pdp__label { padding: 0; margin: 0 0 14px; font-size: 24px; font-weight: 500; }
  .pp-pdp__pills { display: flex; flex-wrap: wrap; gap: 10px; }
  .pp-pdp__pill { min-height: 46px; padding: 0 22px; border-radius: 99px; border: 1.5px solid var(--pp-line); background: #fff; color: var(--pp-ink); font: inherit; font-size: 17px; cursor: pointer; transition: border-color .15s, background .15s, color .15s; }
  .pp-pdp__pill:hover { border-color: var(--pp-ink); }
  .pp-pdp__pill.is-active { background: var(--pp-ink); border-color: var(--pp-ink); color: #fff; }
  .pp-pdp__pill.is-unavailable { color: #aaa; text-decoration: line-through; }
  .pp-pdp__pill.is-active.is-unavailable { color: #ddd; }

  .pp-pdp__buy { display: flex; gap: 14px; flex-wrap: wrap; }
  .pp-qty { display: inline-flex; align-items: center; height: 56px; border: 1.5px solid var(--pp-ink); border-radius: 99px; padding: 0 6px; background: #fff; }
  .pp-qty button { width: 40px; height: 100%; border: 0; background: none; font-size: 22px; cursor: pointer; color: var(--pp-ink); }
  .pp-qty input { width: 56px; border: 0; text-align: center; font: inherit; font-size: 18px; background: none; -moz-appearance: textfield; }
  .pp-qty input::-webkit-outer-spin-button, .pp-qty input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .pp-qty--sm { height: 50px; }
  .pp-btn { flex: 1; min-width: 200px; min-height: 56px; padding: 0 36px; border: 0; border-radius: 99px; background: var(--pp-ink); color: #fff; font: inherit; font-size: 18px; font-weight: 700; cursor: pointer; transition: transform .15s, opacity .2s; }
  .pp-btn:hover:not(:disabled) { transform: translateY(-1px); }
  .pp-btn:disabled { opacity: .45; cursor: not-allowed; }
  .pp-btn--caps { flex: 0 0 auto; min-width: 0; text-transform: uppercase; letter-spacing: .08em; }
  .pp-pdp__dynamic { margin-top: 12px; }
  .pp-pdp__dynamic .shopify-payment-button__button { border-radius: 99px; min-height: 56px; overflow: hidden; }
  .pp-pdp__msg { margin: 14px 0 0; padding: 12px 16px; border-radius: 12px; background: #eaf7ee; color: #1b6b34; }
  .pp-pdp__msg a { color: inherit; font-weight: 700; }
  .pp-pdp__msg.is-error { background: #fdecec; color: #a3261d; }

  .pp-pdp__accs { margin-top: 32px; border-top: 1px solid var(--pp-line); }
  .pp-pdp__acc { border-bottom: 1px solid var(--pp-line); }
  .pp-pdp__acc summary { list-style: none; display: flex; justify-content: space-between; align-items: center; padding: 20px 0; cursor: pointer; font-size: 20px; font-weight: 500; }
  .pp-pdp__acc summary::-webkit-details-marker { display: none; }
  .pp-pdp__acc summary::after { content: '+'; font-size: 26px; font-weight: 300; transition: transform .2s; }
  .pp-pdp__acc[open] summary::after { transform: rotate(45deg); }
  .pp-pdp__acc-body { padding-bottom: 22px; font-size: 16px; line-height: 1.7; color: #444; }
  .pp-pdp__acc-body img { max-width: 100%; height: auto; }

  .pp-pdp__related { margin-top: 96px; }
  .pp-pdp__related-title { margin: 0 0 36px; text-align: center; font-size: clamp(26px, 3vw, 40px); font-weight: 700; }

  /* Sticky bar */
  .pp-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; background: #fff; border-top: 1px solid var(--pp-line); box-shadow: 0 -6px 24px rgba(0,0,0,.05); transform: translateY(110%); transition: transform .3s ease; }
  .pp-bar.is-visible { transform: none; }

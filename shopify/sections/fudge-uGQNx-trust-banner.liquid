{% comment %}
  PetJoy 3 Value Pillars
  Matches store-improvement.replosites.com exactly
{% endcomment %}

<section class="fudge-value-pillars">
  <div class="fudge-value-pillars__container">
    <div class="fudge-value-pillars__grid">
      <!-- Pillar 1 -->
      <div class="fudge-value-item">
        <div class="fudge-value-item__icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#191005" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/>
            <path d="M5 3v4"/>
            <path d="M19 17v4"/>
            <path d="M3 5h4"/>
            <path d="M17 19h4"/>
          </svg>
        </div>
        <div class="fudge-value-item__content">
          <h3 class="fudge-value-item__title">Thoughtfully selected</h3>
          <p class="fudge-value-item__text">Useful pieces for real pet routines, not clutter.</p>
        </div>
      </div>

      <!-- Pillar 2 -->
      <div class="fudge-value-item">
        <div class="fudge-value-item__icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#191005" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
        </div>
        <div class="fudge-value-item__content">
          <h3 class="fudge-value-item__title">Clear product details</h3>
          <p class="fudge-value-item__text">Check fit, use, and care guidance before you decide.</p>
        </div>
      </div>

      <!-- Pillar 3 -->
      <div class="fudge-value-item">
        <div class="fudge-value-item__icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#191005" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
          </svg>
        </div>
        <div class="fudge-value-item__content">
          <h3 class="fudge-value-item__title">Built around their comfort</h3>
          <p class="fudge-value-item__text">Start with the small moments that make a difference.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .fudge-value-pillars {
    background-color: #ffffff;
    border-top: 1px solid #e5e5e5;
    border-bottom: 1px solid #e5e5e5;
    padding: 48px 20px;
    width: 100%;
    box-sizing: border-box;
  }

  @media screen and (min-width: 768px) {
    .fudge-value-pillars {
      padding: 56px 40px;
    }
  }

  .fudge-value-pillars__container {
    max-width: 1240px;
    margin: 0 auto;
  }

  .fudge-value-pillars__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media screen and (min-width: 768px) {
    .fudge-value-pillars__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
  }

  .fudge-value-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .fudge-value-item__icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 6px;
    background-color: #f7f5ef;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #ebe7df;
  }

  .fudge-value-item__content {
    display: flex;
    flex-direction: column;
  }

  .fudge-value-item__title {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: #191005;
    margin: 0 0 6px 0;
    line-height: 1.3;
  }

  .fudge-value-item__text {
    font-family: 'DM Sans', sans-serif;
    font-size: 13.5px;
    line-height: 1.5;
    color: #63594b;
    margin: 0;
  }
</style>

{% schema %}
{
  "name": "Three Value Pillars",
  "settings": [],
  "presets": [
    {
      "name": "Three Value Pillars"
    }
  ]
}
{% endschema %}
{% comment %}
  PetJoy High-Contrast Newsletter Section
{% endcomment %}

<div class="fudge-newsletter" style="background-color: {{ section.settings.bg_color }};">
  <div class="fudge-newsletter__container">
    <div class="fudge-newsletter__card" style="background-color: {{ section.settings.card_bg }};">
      <div class="fudge-newsletter__header">
        <span class="fudge-newsletter__badge">VIP Club</span>
        <h2 class="fudge-newsletter__title" style="color: {{ section.settings.text_color }};">
          {{ section.settings.heading }}
        </h2>
        {%- if section.settings.subheading != blank -%}
          <p class="fudge-newsletter__subheading" style="color: {{ section.settings.text_color }}; opacity: 0.85;">
            {{ section.settings.subheading }}
          </p>
        {%- endif -%}
      </div>

      <div class="fudge-newsletter__form-wrap">
        {% form 'customer', class: 'fudge-newsletter__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          
          {%- if form.posted_successfully? -%}
            <div class="fudge-newsletter__success" tabindex="-1" autofocus>
              ✓ Thanks for subscribing! Welcome to the PetJoy pack.
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="fudge-newsletter__error">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </div>
          {%- endif -%}

          <div class="fudge-newsletter__field-row">
            <input
              id="NewsletterEmail--{{ section.id }}"
              type="email"
              name="contact[email]"
              class="fudge-newsletter__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="{{ section.settings.placeholder | default: 'Enter your email address' }}"
              required
            >
            <button type="submit" class="fudge-newsletter__btn" name="commit">
              {{ section.settings.button_label | default: 'Subscribe' }}
            </button>
          </div>
        {% endform %}
      </div>

      <p class="fudge-newsletter__disclaimer">
        No spam, ever. Unsubscribe anytime with one click.
      </p>
    </div>
  </div>
</div>

<style>
  .fudge-newsletter {
    padding: 60px 20px;
    width: 100%;
    box-sizing: border-box;
  }

  @media screen and (min-width: 768px) {
    .fudge-newsletter {
      padding: 80px 40px;
    }
  }

  .fudge-newsletter__container {
    max-width: 860px;
    margin: 0 auto;
  }

  .fudge-newsletter__card {
    border-radius: 8px;
    padding: 40px 24px;
    text-align: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    border: 1px solid rgba(0, 0, 0, 0.06);
    box-sizing: border-box;
    background-color: #FAF8F3;
  }

  @media screen and (min-width: 768px) {
    .fudge-newsletter__card {
      padding: 56px 48px;
    }
  }

  .fudge-newsletter__badge {
    display: inline-block;
    background-color: #BFD5C6;
    color: #1E1F1D;
    font-family: 'Roboto', sans-serif;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 4px 12px;
    border-radius: 3px;
    margin-bottom: 16px;
  }

  .fudge-newsletter__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 28px;
    font-weight: 700;
    margin: 0 0 10px 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #1E1F1D !important;
    letter-spacing: -0.01em;
  }

  @media screen and (min-width: 768px) {
    .fudge-newsletter__title {
      font-size: 36px;
    }
  }

  .fudge-newsletter__subheading {
    font-family: 'Roboto', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 15px;
    line-height: 1.5;
    max-width: 540px;
    margin: 0 auto 28px auto;
    color: #6E706A !important;
  }

  .fudge-newsletter__form-wrap {
    max-width: 500px;
    margin: 0 auto;
  }

  .fudge-newsletter__field-row {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media screen and (min-width: 550px) {
    .fudge-newsletter__field-row {
      flex-direction: row;
      gap: 10px;
    }
  }

  .fudge-newsletter__input {
    flex-grow: 1;
    font-family: 'Roboto', sans-serif;
    font-size: 14px;
    padding: 12px 18px;
    border-radius: 4px;
    border: 1px solid rgba(0, 0, 0, 0.14);
    background-color: #ffffff;
    color: #1E1F1D;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    box-sizing: border-box;
  }

  .fudge-newsletter__input:focus {
    border-color: #1E1F1D;
    box-shadow: 0 0 0 2px rgba(30, 31, 29, 0.15);
  }

  .fudge-newsletter__btn {
    font-family: 'Roboto', sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 12px 26px;
    border-radius: 4px;
    background-color: #1E1F1D;
    color: #FFFFFF;
    border: none;
    cursor: pointer;
    transition: background-color 0.15s ease, transform 0.1s ease;
    white-space: nowrap;
  }

  .fudge-newsletter__btn:hover {
    background-color: #383A35;
    transform: translateY(-1px);
  }

  .fudge-newsletter__disclaimer {
    font-family: 'Roboto', sans-serif;
    font-size: 12px;
    color: #7b7e87;
    margin: 18px 0 0 0;
  }

  .fudge-newsletter__success {
    background-color: #e8f5e9;
    color: #2e7d32;
    padding: 12px 18px;
    border-radius: 12px;
    font-family: 'Roboto', sans-serif;
    font-size: 14px;
    margin-bottom: 16px;
  }

  .fudge-newsletter__error {
    background-color: #ffebee;
    color: #c62828;
    padding: 12px 18px;
    border-radius: 12px;
    font-family: 'Roboto', sans-serif;
    font-size: 14px;
    margin-bottom: 16px;
  }
</style>

{% schema %}
{
  "name": "High-Contrast Newsletter",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#fef9ee"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#20232b"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join Our Pack!"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Sign up for exclusive offers, pet care tips, and VIP discounts on new arrivals."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Join Now"
    }
  ],
  "presets": [
    {
      "name": "High-Contrast Newsletter"
    }
  ]
}
{% endschema %}